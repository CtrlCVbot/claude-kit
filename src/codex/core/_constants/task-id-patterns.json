{
  "_description": "IMP-KIT-015 — TASK ID 네이밍 표준 정규식 SSOT.",
  "_spec": "docs/archive/kit-2.3.0-roadmap/03-p1-detailed-specs/IMP-KIT-015-task-id-naming.md",
  "schema_version": "1.0",
  "patterns": {
    "dev":    { "regex": "^T-[A-Z]{2,6}-\\d{2,3}$",      "example": "T-HERO-01", "description": "dev Feature TASK" },
    "plan":   { "regex": "^TASK-[a-z0-9-]{3,40}-\\d{2,3}$", "example": "TASK-hero-refresh-03", "description": "plan Feature TASK" },
    "legacy": { "regex": "^LEGACY-[A-Z]{2,6}-\\d{2,3}$",   "example": "LEGACY-AUTH-07", "description": "레거시 격리 TASK" },
    "spike":  { "regex": "^SPIKE-[A-Z]{2,6}-\\d{2,3}$",    "example": "SPIKE-PERF-02", "description": "Spike 조사 TASK" }
  }
}
