{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codex-kit/core/v1/stage-manifest.schema.json",
  "title": "Stage Manifest (Codex sibling)",
  "description": "IMP-KIT-014 — Codex sibling. Claude peer 동일 구조.",
  "type": "object",
  "required": ["schema_version", "slug", "stages"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.\\d+$" },
    "slug": { "type": "string" },
    "stages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["pending", "in-progress", "done", "skipped", "blocked"] },
          "reason": { "type": "string" },
          "started_at": { "type": "string" },
          "completed_at": { "type": "string" }
        }
      }
    },
    "entryPoint": { "type": "string" },
    "blueprintSource": { "type": "string" }
  }
}
