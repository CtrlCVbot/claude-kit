{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codex-kit/core/v1/feedback-entry.schema.json",
  "title": "Feedback Entry (Codex sibling)",
  "description": "kit-feedback-archiving Phase 3 — Codex sibling. Claude peer 동일 구조.",
  "type": "object",
  "required": ["schema_version", "entry_id", "runtime", "command", "domain", "session", "usage"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.\\d+$" },
    "entry_id": { "type": "string", "pattern": "^\\d{8}-\\d{6}-.+$" },
    "runtime": { "type": "string", "enum": ["claude", "codex", "other"] },
    "command": { "type": "string", "pattern": "^/.+" },
    "domain": { "type": "string", "enum": ["plan", "copy", "dev", "core"] },
    "session": {
      "type": "object",
      "required": ["session_id", "started_at", "ended_at", "duration_seconds"],
      "properties": {
        "session_id": { "type": "string" },
        "started_at": { "type": "string" },
        "ended_at": { "type": "string" },
        "duration_seconds": { "type": "number", "minimum": 0 },
        "user": { "type": "string" }
      }
    },
    "context": { "type": "object" },
    "usage": {
      "type": "object",
      "properties": {
        "agents_invoked": { "type": "array" },
        "skills_loaded": { "type": "array" },
        "tools_used": { "type": "object" },
        "manual_edits_count": { "type": "number", "minimum": 0 },
        "human_checkpoints": { "type": "number", "minimum": 0 },
        "reruns": { "type": "number", "minimum": 0 },
        "parallel_executions": { "type": "number", "minimum": 0 }
      }
    },
    "issues_observed": { "type": "array" },
    "agent_capability_gaps": { "type": "array" },
    "suggestions": { "type": "array" },
    "metadata": { "type": "object" }
  }
}
