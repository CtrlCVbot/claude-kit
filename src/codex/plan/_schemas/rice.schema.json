{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude-kit/codex/plan/screening/rice.schema.json",
  "title": "RICE Screening Result (Codex)",
  "description": "plan-idea-screener의 RICE 프레임워크 출력 스키마 — Codex 대응본. Claude 버전(src/claude/plan/_schemas/rice.schema.json)과 구조 동일.",
  "type": "object",
  "required": ["schema_version", "framework", "idea_id", "score", "verdict", "category"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "스키마 버전 (Major.Minor)"
    },
    "framework": {
      "const": "rice"
    },
    "idea_id": {
      "type": "string",
      "pattern": "^IDEA-\\d{8}-\\d{3}$"
    },
    "score": {
      "type": "object",
      "required": ["reach", "impact", "confidence", "effort", "rice_total"],
      "properties": {
        "reach": {
          "type": "number",
          "minimum": 1,
          "maximum": 5,
          "description": "분기당 영향받는 사용자/요청 수 등급 (1-5)"
        },
        "impact": {
          "type": "number",
          "enum": [0.25, 0.5, 1, 2, 3],
          "description": "개별 영향 크기 (Minimal=0.25, Low=0.5, Medium=1, High=2, Massive=3)"
        },
        "confidence": {
          "type": "number",
          "enum": [50, 80, 100],
          "description": "확신도 % (Low=50, Medium=80, High=100)"
        },
        "effort": {
          "type": "number",
          "minimum": 0.1,
          "description": "개발 공수 (person-months)"
        },
        "rice_total": {
          "type": "number",
          "description": "계산값: (reach × impact × confidence) / effort"
        }
      }
    },
    "rationale": {
      "type": "object",
      "required": ["reach", "impact", "confidence", "effort"],
      "properties": {
        "reach": { "type": "string" },
        "impact": { "type": "string" },
        "confidence": { "type": "string" },
        "effort": { "type": "string" }
      },
      "description": "각 요소에 대한 근거 (숫자만 나열 금지 제약 구현)"
    },
    "verdict": {
      "enum": ["Go", "Hold", "Kill"],
      "description": "판정 제안 (사용자 승인 전)"
    },
    "category": {
      "enum": ["Lite", "Standard"]
    },
    "risk_analysis": {
      "type": "object",
      "properties": {
        "technical": { "type": "string" },
        "business": { "type": "string" },
        "schedule": { "type": "string" }
      }
    }
  }
}
