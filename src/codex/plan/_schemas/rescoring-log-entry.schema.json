{
  "$id": "codex-kit/plan/rescoring-log-entry.v1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Rescoring Log Entry (Codex sibling)",
  "description": "IMP-KIT-008 — 재판정 로그 엔트리 스키마. Claude peer: src/claude/plan/_schemas/rescoring-log-entry.schema.json",
  "type": "object",
  "required": ["ideaId", "prev", "new", "rationale"],
  "additionalProperties": true,
  "properties": {
    "ideaId": { "type": "string", "pattern": "^IDEA-" },
    "timestamp": { "type": "string" },
    "prev": { "$ref": "#/$defs/judgment" },
    "new": { "$ref": "#/$defs/judgment" },
    "rationale": { "type": "string", "minLength": 1, "maxLength": 200 }
  },
  "$defs": {
    "judgment": {
      "type": "object",
      "required": ["status", "score"],
      "properties": {
        "status": { "type": "string", "enum": ["Go", "Hold", "Kill"] },
        "score": { "type": "number" },
        "framework": { "type": "string", "enum": ["rice", "5axis"] },
        "date": { "type": "string" }
      }
    }
  }
}
