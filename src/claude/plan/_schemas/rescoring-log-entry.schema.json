{
  "$id": "claude-kit/plan/rescoring-log-entry.v1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Rescoring Log Entry",
  "description": "IMP-KIT-008 — plan-idea-screener 재판정 로그 엔트리 스키마. agent-memory/plan-idea-screener/MEMORY.md에 append되는 단일 엔트리 구조.",
  "type": "object",
  "required": ["ideaId", "prev", "new", "rationale"],
  "additionalProperties": true,
  "properties": {
    "ideaId": {
      "type": "string",
      "pattern": "^IDEA-",
      "description": "IDEA-{YYYYMMDD}-{NNN} 형태 식별자"
    },
    "timestamp": {
      "type": "string",
      "description": "재판정 시각 (YYYY-MM-DD HH:mm 또는 ISO 8601)"
    },
    "prev": { "$ref": "#/$defs/judgment" },
    "new": { "$ref": "#/$defs/judgment" },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "전환 사유 (100자 이내 권장)"
    }
  },
  "$defs": {
    "judgment": {
      "type": "object",
      "required": ["status", "score"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["Go", "Hold", "Kill"]
        },
        "score": {
          "type": "number"
        },
        "framework": {
          "type": "string",
          "enum": ["rice", "5axis"]
        },
        "date": {
          "type": "string"
        }
      }
    }
  }
}
